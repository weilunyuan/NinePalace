{
  "name": "ninepalace",
  "version": "0.1.0",
  "private": true,
  "description": "中国象棋人机与局域网好友对弈原型",
  "author": "NinePalace contributors",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "web": "electron . --web-server",
    "web:smoke": "electron . --web-ui-smoke-test",
    "relay": "node relay/server.cjs",
    "test": "node --test",
    "build:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.ninepalace.desktop",
    "productName": "NinePalace",
    "asar": true,
    "files": [
      "desktop/**/*",
      "!desktop/assets/ninepalace-mascot-fish.png",
      "!desktop/assets/ninepalace-xiangqi-girl.png",
      "!desktop/assets/ninepalace-rook-character.png",
      "!desktop/assets/ninepalace-cannon-character.png",
      "!desktop/assets/ninepalace-pawn-character.png",
      "!desktop/assets/ninepalace-lobby-character.png",
      "!desktop/assets/*-draft.png",
      "relay/server.cjs",
      "vendor/xiangqi-js/xiangqi.js",
      "vendor/xiangqi-js/LICENSE",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "VENDOR_NOTICES.md",
        "to": "VENDOR_NOTICES.md"
      },
      {
        "from": "vendor/pikafish",
        "to": "pikafish",
        "filter": [
          "pikafish.exe",
          "pikafish.nnue",
          "Copying.txt",
          "NNUE-License.md",
          "README.md"
        ]
      },
      {
        "from": "vendor/fairy-stockfish",
        "to": "fairy-stockfish",
        "filter": [
          "fairy-stockfish.exe",
          "Copying.txt",
          "README.md"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NinePalace-${version}-win-x64.exe",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "NinePalace-${version}-win-x64.exe"
    }
  },
  "dependencies": {
    "ws": "8.23.0"
  }
}
